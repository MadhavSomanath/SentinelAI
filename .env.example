APP_NAME=SentinelAI
ENVIRONMENT=development
LOG_LEVEL=INFO
REPOSITORY_MODE=supabase
DEFAULT_PROVIDER=mock
ENABLE_LANGFUSE=true
API_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
FIREWALL_THRESHOLD=0.55
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
INJECTION_CLASSIFIER_ENABLED=true
INJECTION_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_CLASSIFIER_THRESHOLD=0.5

# Every route except /health needs X-API-Key. Use long random values.
ADMIN_API_KEY=change-me-admin-key
API_KEYS={"change-me-user-key": "demo-user"}

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

OPENAI_API_KEY=
